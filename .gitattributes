# Keep repository text files stable across platforms.
* text=auto eol=lf

# Explicitly mark source and data text.
*.py text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary research assets and archives.
*.pdf binary
*.zip binary
*.xlsx binary
*.xls binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
